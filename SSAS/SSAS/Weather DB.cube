  <Source dwd:design-time-name="ca5e4647-f4eb-48f7-92c7-e62ffc86b958">
    <DataSourceViewID>Weather DB</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="8451d721-1da0-44b4-be6a-2ed956d1c689">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE DYNAMIC SET CURRENTCUBE.[caucuaco]
 AS TOPCOUNT(
    CROSSJOIN(
        [DIM LOCATION].[Region].[Region].Members,
        FILTER(
            [DIM DATE].[Date id].[Date id].Members,
            [Measures].[Humidi] &gt; 50
        )
    ),
    3,
    [Measures].[Avg Rain]
) ;                    
CREATE DYNAMIC SET CURRENTCUBE.[Cau1]
 AS TOPCOUNT(
    [DIM LOCATION].[Province].[Province].Members,
    10,
    ([Measures].[Avg Rain])
);                 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Rain]
 AS [Measures].[Total Rain]/[Measures].[WeatherCount], 
VISIBLE = 1;                
CREATE DYNAMIC SET CURRENTCUBE.[Cau2]
 AS ORDER( [DIM LOCATION].[Region].[Region].Members , [Measures].[Avg Rain] , DESC);               
CREATE MEMBER CURRENTCUBE.[Measures].[RainDays]
 AS ([Measures].[WeatherCount], [DIM STATUS].[STATUS].&amp;[Mua]), 
VISIBLE = 1;               
CREATE MEMBER CURRENTCUBE.[Measures].[WeatherRate]
 AS IIF(
    ([Measures].[WeatherCount]) = 0,
    0,
    ([Measures].[WeatherCount])
    /
    SUM(
        [DIM STATUS].[STATUS].[STATUS].Members,
        ([Measures].[WeatherCount])
    )
), 
VISIBLE = 1;             
CREATE MEMBER CURRENTCUBE.[Measures].[AvgRainPerRainyDay]
 AS IIF([Measures].[RainDays] = 0 OR ISEMPTY([Measures].[RainDays]),
        NULL,
        [Measures].[Total Rain] / [Measures].[RainDays]
    ), 
VISIBLE = 1;             
CREATE DYNAMIC SET CURRENTCUBE.[Cau8]
 AS TOPCOUNT(
{
    [DIM LOCATION].[Province].[Province].[Nha Trang],
    [DIM LOCATION].[Province].[Province].[Ben Tre],
    [DIM LOCATION].[Province].[Province].[Bien Hoa],
    [DIM LOCATION].[Province].[Province].[Ca Mau],
    [DIM LOCATION].[Province].[Province].[Uong Bi],
    [DIM LOCATION].[Province].[Province].[Yen Bai]
}, 7, [Measures].[RainDays]
);             
CREATE DYNAMIC SET CURRENTCUBE.[Cau9]
 AS FILTER(
    [DIM LOCATION].[Province].[Province].Members,
    [Measures].[SlightDecrease] = 1
);             
CREATE MEMBER CURRENTCUBE.[Measures].[RainRate2021]
 AS ([Measures].[WeatherRate], [DIM DATE].[Year].&amp;[2021], [DIM STATUS].[STATUS].&amp;[Mua]), 
VISIBLE = 1;             
CREATE MEMBER CURRENTCUBE.[Measures].[RainRate2020]
 AS ([Measures].[WeatherRate], [DIM DATE].[Year].&amp;[2020], [DIM STATUS].[STATUS].&amp;[Mua]), 
VISIBLE = 1;            
CREATE MEMBER CURRENTCUBE.[Measures].[RainRateChange]
 AS [Measures].[RainRate2021] - [Measures].[RainRate2020], 
VISIBLE = 1;             
CREATE MEMBER CURRENTCUBE.[Measures].[SlightDecrease]
 AS IIF([Measures].[RainRateChange] &lt; 0 
        AND [Measures].[RainRateChange] &gt; -0.1, 1, 0), 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[ProvincesWithRain]
 AS COUNT(
    FILTER(
        [DIM LOCATION].[Province].[Province].Members,
        ([Measures].[WeatherCount], [DIM STATUS].[STATUS].&amp;[Mua]) &gt; 0
    )
), 
VISIBLE = 1;     
CREATE DYNAMIC SET CURRENTCUBE.[Cau11]
 AS TOPCOUNT(
        [DIM LOCATION].[Province].[Province].Members,
        10,
        [Measures].[Total Rain]
    );     
CREATE MEMBER CURRENTCUBE.[Measures].[RainRate_Percent]
 AS ([Measures].[WeatherRate], [DIM STATUS].[STATUS].&amp;[Mua]), 
VISIBLE = 1;     
CREATE MEMBER CURRENTCUBE.[Measures].[RainDaysYearTotal]
 AS SUM(
     [DIM DATE].[Year].CurrentMember,
     [Measures].[RainDays]
 ), 
VISIBLE = 1;           
CREATE DYNAMIC SET CURRENTCUBE.[Cau13]
 AS TOPCOUNT(
        [DIM WIND].[Wind D].[Wind D].Members,
        10,
        [Measures].[WindDirectionDayCount2014]
    );          
CREATE MEMBER CURRENTCUBE.[Measures].[WindDirectionDayCount2014]
 AS DISTINCTCOUNT(
     (
         [DIM DATE].[Date id].[Date id],
         [DIM DATE].[Year].&amp;[2014]
     )
 ), 
VISIBLE = 1;        
CREATE DYNAMIC SET CURRENTCUBE.[Cau14]
 AS FILTER(
        [DIM LOCATION].[Province].[Province].Members,
        [Measures].[Avg Rain] &gt; 7
    );      
CREATE MEMBER CURRENTCUBE.[Measures].[MaxTemp2021]
 AS MAX(
    [DIM DATE].[Date id].[Date id].Members,
    ([Measures].[max temp], [DIM DATE].[Year].[2021])
), 
VISIBLE = 1;      
CREATE MEMBER CURRENTCUBE.[Measures].[MinTemp2021]
 AS MIN(
        [DIM DATE].[Date id].[Date id].Members,
        ([Measures].[min temp], [DIM DATE].[Year].[2021])
    ), 
VISIBLE = 1;      
CREATE MEMBER CURRENTCUBE.[Measures].[AvgTemp2021]
 AS ([Measures].[Avg temp], [DIM DATE].[Year].[2021])
    / 
    ([Measures].[WeatherCount], [DIM DATE].[Year].[2021]), 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>